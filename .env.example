# ─── Database ───────────────────────────────────────────────
# Local (docker-compose) default; override with Neon/Supabase URL in prod
DATABASE_URL="postgresql://crm:crm@localhost:5432/crm?schema=public"

# ─── Redis (cache, BullMQ queues, Socket.IO adapter) ────────
REDIS_URL="redis://localhost:6379"

# ─── Auth (custom NestJS JWT + RBAC + TOTP MFA) ─────────────
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"
MFA_ISSUER="CRM Lead & Sales"

# ─── Trusted devices (skip login OTP on known browsers) ─────
# After a login code is verified, the browser gets an HTTP-only cookie and skips
# the OTP until it expires (trust period + on/off live in Authentication
# Settings; default 180 days). Logging out keeps it — only expiry, a password
# change, or a revoke drops it.
# Signing key for the cookie. Falls back to JWT_ACCESS_SECRET when blank;
# changing either value invalidates every trusted device.
TRUSTED_DEVICE_SECRET=""
# SameSite mode. Keep "lax" when the web app and API share a registrable domain
# (including localhost:3000 → localhost:4000). Set "none" ONLY when they are on
# different domains — browsers then require HTTPS, and Secure is forced on.
TRUSTED_DEVICE_COOKIE_SAMESITE="lax"
# Force the Secure flag. Defaults to on when NODE_ENV=production.
# TRUSTED_DEVICE_COOKIE_SECURE="true"
# Share the cookie across subdomains, e.g. ".example.com". Leave blank for
# host-only (the safer default).
# TRUSTED_DEVICE_COOKIE_DOMAIN=""

# ─── API ────────────────────────────────────────────────────
API_PORT="4000"
WEB_ORIGIN="http://localhost:3000"

# ─── Frontend ───────────────────────────────────────────────
NEXT_PUBLIC_API_URL="http://localhost:4000"
NEXT_PUBLIC_WS_URL="http://localhost:4000"

# ─── Object storage (recordings, exports) — Phase 3 ─────────
S3_ENDPOINT=""
S3_REGION="us-east-1"
S3_BUCKET="crm-recordings"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# ─── Calling provider (Twilio) — Phase 3 ────────────────────
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_API_KEY=""
TWILIO_API_SECRET=""
TWILIO_TWIML_APP_SID=""
TWILIO_CALLER_ID=""

# ─── OpenPhone (calling / SMS) ──────────────────────────────
# Leave blank to run in SANDBOX mode. Set the API key to hit the real API.
OPENPHONE_API_KEY=""
OPENPHONE_BASE_URL="https://api.openphone.com/v1"
OPENPHONE_TIMEOUT_MS="10000"
# OPENPHONE_SANDBOX="true"   # force sandbox even when a key is set
OPENPHONE_WEBHOOK_SECRET=""   # HMAC secret to verify POST /api/webhooks/quo
# ─── Call routing: every call goes to the Quo app ───────────
# The CRM never dials in the browser. Outbound calls, click-to-call, callbacks,
# queue calls and redial all hand the number to the installed Quo app using Quo's
# documented deep link:
#     openphone://dial?number=<e164>&from=<line>&action=call
# and the incoming-call popup's "Attend" launches the same app to pick up.
#
# Scheme the installed app registers (like slack:// or zoommtg://). Defaults to
# openphone://; set quo:// if your app registers that instead. NEXT_PUBLIC_* is
# build-time for the web app; QUO_APP_SCHEME is the API-side copy used to build
# the dial link returned by POST /communications/lead/:id/call.
NEXT_PUBLIC_QUO_APP_SCHEME="openphone://"
QUO_APP_SCHEME="openphone://"
# Override the whole dial URL, with {number} and {from} placeholders (both
# URL-encoded on substitution). Quo documents the deep link above for its MOBILE
# apps; on desktop the scheme launches the app, and whether it also auto-dials
# depends on that build honouring the parameters. If your desktop app wants a
# different path or parameter names, set it here — no code change, no redeploy.
# Leave blank to use the documented format.
# NEXT_PUBLIC_QUO_DIAL_TEMPLATE="openphone://dial?number={number}&from={from}&action=call"
# QUO_DIAL_TEMPLATE="openphone://dial?number={number}&from={from}&action=call"
# Emergency fallback ONLY: also fire a tel: link when a call is placed. Off by
# default and best left off — tel: goes to whatever the OS registered as the
# default calling app, which is often a browser page or a "how do you want to
# open this?" chooser. Turn it on only for machines with no Quo app installed,
# accepting that calls there may leave the Quo workflow.
# NEXT_PUBLIC_QUO_TEL_FALLBACK="false"

# ─── Temporary lead-processing mode ─────────────────────────
# Turns OFF every outgoing call in the CRM (click-to-call, dial pad, queue
# auto-dial, the Quo app handoff and the in-call controls) while the queue keeps
# working: agents review each lead, log the outcome and notes, save, and the next
# lead loads automatically. Incoming calls still ring in Quo as usual.
#
# The normal switch is Settings → Calling → Calling Mode (admin), stored in
# app_settings so it flips without a deploy. This env var FORCES it off
# regardless of that setting — the lever that still works when the admin UI
# isn't reachable. Leave unset for normal operation.
# CALLING_DISABLED="true"

# ─── Quo integration (Lead sync) ───────────────────────────
# Leave blank to run in SANDBOX mode (simulated Quo responses, no real calls).
# Set base URL + API key to hit the real Quo API (auth: API key header).
QUO_BASE_URL=""
QUO_API_KEY=""
QUO_TIMEOUT_MS="10000"
# QUO_SANDBOX="true"   # force sandbox even when creds are set

# ─── AI (Claude / Anthropic, swappable) — Phase 5 ───────────
LLM_PROVIDER="anthropic"
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-opus-4-8"
# OPENAI_API_KEY=""   # alternative provider

# ─── Email (callback reminders / notifications) ─────────────
# Leave SMTP_HOST blank to run without email (reminders are logged, not sent).
SMTP_HOST=""
SMTP_PORT="587"            # 465 = implicit TLS, otherwise STARTTLS
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="CRM <no-reply@crm.local>"
# Login-OTP recipient override. When set, every login verification code is sent
# to THIS address, overriding whatever is saved in Authentication Settings. Use
# it to (re)point OTP delivery without DB/admin access — e.g. if the stored
# recipient is unreachable and you're locked out. Leave blank to use the value
# configured in the admin UI.
OTP_RECIPIENT_EMAIL=""
# Optional extra manager/admin recipient for callback alerts. Active admins &
# team leaders are always emailed; this is also editable via AppSetting
# key "callbacks:notify_email".
# (No env var — set the override in the app_settings table.)

# ─── Call hygiene ───────────────────────────────────────────
# A call is written when the agent clicks Call and only closed by the wrap-up, so
# shutting the tab mid-call leaves it open forever — pinning the lead at the top
# of the queue and marking the rep "On Call". A sweep closes stale ones every
# 10 min, stamping status=abandoned with a 0s duration (they are excluded from
# the connected/talk-time figures rather than inventing a length).
# Must comfortably exceed your longest real call — closing a live one truncates it.
ABANDONED_CALL_AFTER_MS="14400000"   # 4 hours
# ABANDONED_CALL_CRON="off"          # disable the sweep entirely

# ─── Quo webhook (proxied path delivery) ────────────────────
# Quo posts to https://<your-host>/hook/<token>, proxied straight through to this
# API. That path is exempt from the /api prefix. The token IS the credential for
# a public endpoint that creates leads and calls, so delivery is REJECTED unless
# this matches — set it to the token in your Quo webhook URL. Real value goes in
# .env (gitignored), never here.
QUO_WEBHOOK_PATH_TOKEN=""
# Signing secret, if Quo signs deliveries — verified in addition to the token.
#
# ACCEPTS A LIST (comma- or space-separated). A Quo workspace can have more than
# one webhook subscription pointed at the same URL, and each signs with its OWN
# secret — so with a single secret configured, half of every delivery pair fails
# the signature check, 403s, and is retried by Quo indefinitely. List every
# subscription's secret here (or delete the duplicate subscription in Quo, which
# is tidier). GET /api/communications/webhook/health reports accepted vs rejected
# counts and flags `duplicateSubscriptionSuspected` when both are non-zero.
QUO_WEBHOOK_SECRET="NFVOMUVERGhKRW9mY01oZlMweG1oYm9mbElHRXNCRTc="
