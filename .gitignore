# builds
dist/
build/
.next/
out/
.turbo/
# TypeScript's incremental-build cache. Rewritten by every typecheck and every
# build, so tracking it meant the tree was never clean for longer than it took
# to run one — and it carries nothing a checkout needs.
*.tsbuildinfo

# env & secrets
.env
.env.local
.env.*.local
!.env.example

# prisma
packages/database/prisma/*.db

# logs
*.log
npm-debug.log*

# os / editor
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# test / coverage
coverage/
