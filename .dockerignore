# Deps & build outputs — rebuilt inside the image for the correct platform.
node_modules
**/node_modules
**/dist
apps/crm-web/.next
**/.next
**/*.tsbuildinfo

# Secrets & local runtime files — real env comes from Northflank at runtime.
.env
.env.*
*.log
webhook-deliveries.log

# VCS & tooling noise.
.git
.gitignore
.claude
.vscode
.cursor
.agents
.github

# Documents and local scratch files — nothing the API builds or runs, and no
# business documents belong in a production image.
*.xlsx
*.session.sql
SOLUTION_DESIGN.md
README.md
infrastructure
