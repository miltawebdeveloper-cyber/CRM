// CRM Lead & Sales System — data model
// Standards (DB-013..017): UUID PKs, soft-delete on leads, indexes on filter
// columns, Prisma-only access. See SOLUTION_DESIGN.md §5.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"] // enables datasource `extensions`
}

datasource db {
  provider   = "postgresql"
  extensions = [pgcrypto] // pgcrypto -> gen_random_uuid(); vector (Phase 5 AI embeddings) re-add once pgvector is installed
}

// ─────────────────────────── Enums ───────────────────────────

enum Role {
  admin
  team_leader
  employee // caller
  viewer
}

enum Timezone {
  EST
  CST
  MST
  PST
}

enum LeadStatus {
  new
  in_progress
  contacted
  interested
  closed
  rejected
}

enum NotificationType {
  target_complete
  low_progress
  new_leads
  idle_alert
  callback_reminder
  callback_due
  callback_missed
  zoom_scheduled
  zoom_reminder
  zoom_due
  zoom_cancelled
}

enum AiTopic {
  tax
  bookkeeping
  sales_script
  company_ops
}

enum SpeakingSpeed {
  too_fast
  optimal
  too_slow
}

enum TaskStatus {
  todo
  in_progress
  review
  done
}

enum TaskPriority {
  high
  medium
  low
}

/// Lead → Quo integration sync state
enum QuoSyncStatus {
  not_synced
  pending
  synced
  failed
}

/// Calls Made funnel bucket for a call outcome (see model Outcome.category).
/// `connected` covers reached-but-still-working statuses (follow-ups, meetings)
/// which sit outside the Cold → Warm → Hot → Closed progression.
enum OutcomeCategory {
  cold
  warm
  hot
  connected
  closed_positive
  closed_negative
}

/// Zoom meeting lifecycle status
enum ZoomMeetingStatus {
  scheduled
  in_progress
  completed
  cancelled
  rescheduled
}

/// User work availability (drives auto-reassignment)
enum Availability {
  online
  offline
}

/// Type of work item that was auto-reassigned
enum ReassignType {
  call
  callback
  followup
  zoom
  task
}

// ─────────────────────────── Core ────────────────────────────

/// DB-001 — all system users
model User {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         Role     @default(employee)
  isActive     Boolean  @default(true) @map("is_active")

  // MFA (TOTP) — see auth module
  mfaEnabled Boolean @default(false) @map("mfa_enabled")
  mfaSecret  String? @map("mfa_secret")

  // ── Availability & auto-reassignment ──
  availability       Availability @default(online)
  availabilityReason String?      @map("availability_reason") // Leave / Holiday / Unavailable / No Login
  lastLoginAt        DateTime?    @map("last_login_at")

  // OpenPhone/Quo number this caller sends SMS and dials from (E.164, e.g. +15551234567).
  // Admin-assigned and UNIQUE: it is the caller identity the customer sees, so no two
  // users may share one. Nullable (many users may be unassigned) — but an unassigned
  // user is blocked from placing outbound calls, never silently handed a shared line.
  openphoneNumber String? @unique @map("openphone_number")
  shiftStart         String?      @map("shift_start") // "HH:mm" local start time (default 09:00)
  noLoginHandledOn   DateTime?    @map("no_login_handled_on") @db.Date // dedupe stamp for the no-login cron

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // relations
  employee          Employee?
  assignedLeads     Lead[]              @relation("LeadAssignedTo")
  closedLeads       Lead[]              @relation("LeadClosedBy")
  targetsSet        Target[]            @relation("TargetSetBy")
  activities        Activity[]
  loginOtps         LoginOtp[]
  activityAssignedTo Activity[]          @relation("ActivityAssignedTo")
  assignmentsMade   Assignment[]        @relation("AssignmentAssignedBy")
  assignmentsTaken  Assignment[]        @relation("AssignmentCaller")
  calls             Call[]
  sentMessages      Message[]           @relation("MessageSender")
  notes             Note[]
  productivityLogs  ProductivityLog[]
  notifications     Notification[]
  aiSessions        AiTrainingSession[]
  coachingReports   VoiceCoachingReport[]
  tasks             Task[]
  preferences       UserPreference[]
  zoomMeetings      ZoomMeeting[]         @relation("ZoomOrganizer")
  zoomActivities    ZoomMeetingActivity[] @relation("ZoomActivityUser")

  @@index([role])
  @@index([isActive])
  @@map("users")
}

/// System-wide settings (key-value). Used to store integration credentials
/// (key = "integration:<provider>", value = { ENV_VAR: value, ... }) entered
/// from the admin UI, applied to runtime config on boot and on save.
/**
 * A pending login OTP challenge.
 *
 * The code itself is never stored — only a hash — so a leaked database row can't
 * be used to complete someone's login. Rows are short-lived (minutes) and are
 * consumed on first successful use; `attempts` caps brute-forcing a 6-digit code.
 */
model LoginOtp {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash   String    @map("code_hash")
  expiresAt  DateTime  @map("expires_at")
  attempts   Int       @default(0)
  consumedAt DateTime? @map("consumed_at")
  /** Address the code was delivered to, for the audit trail. */
  sentTo     String    @map("sent_to")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@index([expiresAt])
  @@map("login_otps")
}

model AppSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("app_settings")
}

/// Admin-configurable call outcomes (dispositions). `slug` is stored on
/// Call.outcome; `schedulesCallback` flags outcomes that open the callback
/// workflow (mandatory date/time, pinned queue, reminders).
model Outcome {
  id                String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug              String      @unique
  name              String
  color             String      @default("#6b7359")
  schedulesCallback Boolean     @default(false) @map("schedules_callback")
  schedulesZoom     Boolean     @default(false) @map("schedules_zoom") // prompts a Zoom meeting on this outcome
  leadStatus        LeadStatus? @map("lead_status") // status applied to the lead on this outcome
  // Bucket this status falls into on the Calls Made funnel. Null = ungrouped:
  // the status still shows in the per-status breakdown but sits outside the
  // Cold → Warm → Hot → Closed pipeline.
  category          OutcomeCategory? @map("category")
  sortOrder         Int         @default(0) @map("sort_order")
  isActive          Boolean     @default(true) @map("is_active")
  createdAt         DateTime    @default(now()) @map("created_at")
  updatedAt         DateTime    @updatedAt @map("updated_at")

  @@map("outcomes")
}

/// Per-user UI preferences (key-value). Used for customizable table column
/// layouts (key = "cols:<tableKey>", value = { order, hidden }), and reusable
/// for other personal settings later.
model UserPreference {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  key       String
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, key])
  @@map("user_preferences")
}

/// DB-008 — extended caller/employee profile
model Employee {
  id               String   @id @db.Uuid // FK == users.id
  user             User     @relation(fields: [id], references: [id], onDelete: Cascade)
  shiftTimezone    Timezone @default(EST) @map("shift_timezone")
  performanceScore Float    @default(0) @map("performance_score")
  createdAt        DateTime @default(now()) @map("created_at")

  // ── Calls Made target (see modules/calls) ──
  // Calls this rep is expected to make per working day. The dashboard scales it
  // across the selected range (target × days) — a per-day figure is what the
  // team already reports against. 0 = no target set, and the dial is hidden.
  dailyCallTarget  Int     @default(0) @map("daily_call_target")
  // Free-text note shown on the dial when the target isn't being met.
  targetMissReason String? @map("target_miss_reason")

  @@map("employees")
}

/// DB-002 — central leads table. Deleting a lead is a permanent hard delete
/// that cascades to every dependent record (assignments, calls + notes/coaching
/// reports, notes, activities, messages, quo sync logs, zoom meetings). The
/// `deletedAt` column is retained for historical rows / backward compat.
model Lead {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  leadId       String     @map("lead_id") // external id from import
  businessName String     @map("business_name")
  phone        String
  email        String?
  state        String
  city         String
  timezone     Timezone   @default(EST)
  status       LeadStatus @default(new)
  qualityScore Int?       @map("quality_score") // AI lead score 0..100

  // ── Lead sheet fields (import column set) ──
  contactName      String?   @map("contact_name") // NAME — contact person at the company
  industry         String? // INDUSTRY
  title            String? // TITLE — contact's job title
  employeeCode     String?   @map("employee_code") // Employee Code
  comments         String? // COMMENTS
  leadCategory     String?   @map("lead_category") // LEAD CATEGORY
  nextFollowUpDate DateTime? @map("next_follow_up_date") // NEXT FOLLOW UP DATE
  callStatus       String?   @map("call_status") // CALL STATUS
  firstContact     DateTime? @map("first_contact") // FIRST CONTACT
  lastContact      DateTime? @map("last_contact") // LAST CONTACT
  followupCount    Int?      @map("followup_count") // FOLLOW-UP COUNT
  meetingDate      DateTime? @map("meeting_date") // MEETING DATE
  lostReason       String?   @map("lost_reason") // LOST REASON
  callbackAt       DateTime? @map("callback_at")
  leadGenerationId String?   @map("lead_generation_id")
  leadSource       String?   @map("lead_source")
  contactName2     String?   @map("contact_name_2")
  altPhone         String?   @map("alt_phone")
  website          String?
  socialMedia      String?   @map("social_media")
  country          String?
  companySize      String?   @map("company_size")
  foundedYear      String?   @map("founded_year")
  address          String?
  callbackCompletedAt DateTime? @map("callback_completed_at")
  // Reminder dedupe stamps — set once each reminder fires so the cron never repeats.
  callbackReminderDayBeforeAt DateTime? @map("callback_reminder_day_before_at")
  callbackReminderDueAt       DateTime? @map("callback_reminder_due_at")
  callbackReminderMissedAt    DateTime? @map("callback_reminder_missed_at")
  // CALLER → assignedTo (User relation below)

  // ── Quo (OpenPhone) telephony ──
  quoContactId        String?   @map("quo_contact_id") // provider contact id
  lastCommunicationAt DateTime? @map("last_communication_at")

  // ── Quo integration (see modules/quo) ──
  quoStatus     QuoSyncStatus @default(not_synced) @map("quo_status")
  quoExternalId String?       @map("quo_external_id") // id returned by Quo
  quoResponse   Json?         @map("quo_response") // last raw Quo response
  quoError      String?       @map("quo_error") // last sync error message
  quoSyncedAt   DateTime?     @map("quo_synced_at")

  assignedToId String? @map("assigned_to") @db.Uuid
  assignedTo   User?   @relation("LeadAssignedTo", fields: [assignedToId], references: [id])

  // ── Closure (see modules/leads/lead-closure.ts) ──
  // Stamped when the lead enters `closed` and cleared when it leaves, so the
  // Closed Leads module can show who closed each lead and scope employees to
  // their own closures.
  closedAt   DateTime? @map("closed_at")
  closedById String?   @map("closed_by") @db.Uuid
  closedBy   User?     @relation("LeadClosedBy", fields: [closedById], references: [id])

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  assignments  Assignment[]
  calls        Call[]
  notes        Note[]
  activities   Activity[]
  quoSyncLogs  QuoSyncLog[]
  messages     Message[]
  zoomMeetings ZoomMeeting[]

  // DB-015 — indexes on every dashboard filter column
  @@unique([leadId])
  @@index([state])
  @@index([city])
  @@index([timezone])
  @@index([status])
  @@index([assignedToId])
  @@index([deletedAt])
  @@index([closedById])
  @@map("leads")
}

/// Audit trail of every Quo sync attempt (request + response). Powers error
/// handling/visibility and is the pattern other module integrations will reuse.
model QuoSyncLog {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  leadId     String   @map("lead_id") @db.Uuid
  lead       Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  success    Boolean
  statusCode Int?     @map("status_code") // HTTP status from Quo
  request    Json? // payload sent to Quo
  response   Json? // raw response (or error body) from Quo
  error      String? // error message if the call failed
  durationMs Int?     @map("duration_ms")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([leadId])
  @@index([createdAt])
  @@map("quo_sync_logs")
}

/// Zoom meeting scheduled with a client (lead). Behaves like a callback in the
/// Call Panel (pinned when due) and maintains a full per-client meeting history.
model ZoomMeeting {
  id          String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  leadId      String            @map("lead_id") @db.Uuid
  lead        Lead              @relation(fields: [leadId], references: [id], onDelete: Cascade)
  organizerId String?           @map("organizer_id") @db.Uuid
  organizer   User?             @relation("ZoomOrganizer", fields: [organizerId], references: [id])

  title        String?
  scheduledAt  DateTime          @map("scheduled_at")
  durationMins Int               @default(30) @map("duration_mins")
  status       ZoomMeetingStatus @default(scheduled)

  // ── Zoom join details (manual now; populated by a Zoom API later) ──
  joinUrl      String? @map("join_url")
  meetingId    String? @map("meeting_id") // Zoom meeting id
  passcode     String?
  participants String? // invited participants (names / emails)

  // ── Lifecycle timestamps ──
  startedAt DateTime? @map("started_at")
  endedAt   DateTime? @map("ended_at")

  // ── Reminder dedupe stamps (set once each reminder fires; reset on reschedule) ──
  reminderDayBeforeAt DateTime? @map("reminder_day_before_at")
  reminderDueAt       DateTime? @map("reminder_due_at")

  // ── Pre-meeting context ──
  agenda String? // meeting agenda
  reason String? // why the meeting was conducted

  // ── Post-meeting record (history) ──
  outcome        String?
  notes          String?
  summary        String? // what was discussed
  clientFeedback String?   @map("client_feedback")
  decisions      String? // decisions made during the meeting
  actionItems    String?   @map("action_items") // newline-separated action items
  followUpAt     DateTime? @map("follow_up_at") // next meeting / follow-up time

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // ── Linked task (auto-created & kept in sync with the Tasks module) ──
  taskId String? @unique @map("task_id") @db.Uuid
  task   Task?   @relation("ZoomMeetingTask", fields: [taskId], references: [id], onDelete: SetNull)

  activities ZoomMeetingActivity[]

  @@index([leadId])
  @@index([organizerId])
  @@index([scheduledAt])
  @@index([status])
  @@map("zoom_meetings")
}

/// Audit trail for a Zoom meeting — one row per action/modification.
model ZoomMeetingActivity {
  id        String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  meetingId String      @map("meeting_id") @db.Uuid
  meeting   ZoomMeeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  userId    String?     @map("user_id") @db.Uuid
  user      User?       @relation("ZoomActivityUser", fields: [userId], references: [id])

  action   String // created | rescheduled | cancelled | started | completed | notes_updated | outcome_updated | follow_up_created | updated …
  field    String? // which field changed (when applicable)
  oldValue String? @map("old_value")
  newValue String? @map("new_value")
  remarks  String?

  createdAt DateTime @default(now()) @map("created_at")

  @@index([meetingId])
  @@index([createdAt])
  @@map("zoom_meeting_activities")
}

/// DB-003 — planned lead targets per city
model Target {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  state         String
  city          String
  timezone      Timezone
  monthlyTarget Int      @map("monthly_target")
  setById       String?  @map("set_by") @db.Uuid
  setBy         User?    @relation("TargetSetBy", fields: [setById], references: [id])
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@unique([state, city, timezone])
  @@index([timezone])
  @@map("targets")
}

/// DB-004 — immutable audit/activity log (insert-only)
model Activity {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  leadId    String?  @map("lead_id") @db.Uuid
  lead      Lead?    @relation(fields: [leadId], references: [id], onDelete: Cascade)
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id])
  action    String
  oldValue  String?  @map("old_value")
  newValue  String?  @map("new_value")
  remarks   String?
  ipAddress String?  @map("ip_address")
  createdAt DateTime @default(now()) @map("created_at")

  callStatus   String? @map("call_status")
  assignedToId String? @map("assigned_to_id") @db.Uuid
  assignedTo   User?   @relation("ActivityAssignedTo", fields: [assignedToId], references: [id])

  @@index([leadId])
  @@index([userId])
  @@index([createdAt])
  @@map("activities")
}

/// Audit/feed of work auto-reassigned when a user goes offline (or fails to
/// log in). Denormalized (owner name + client name) so the new assignee's
/// dashboard can render it without joins.
model WorkReassignment {
  id           String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type         ReassignType
  reason       String // Offline / Leave / Holiday / No Login / Unavailable
  fromUserId   String       @map("from_user") @db.Uuid
  fromUserName String       @map("from_user_name")
  toUserId     String       @map("to_user") @db.Uuid
  leadId       String?      @map("lead_id") @db.Uuid
  zoomMeetingId String?     @map("zoom_meeting_id") @db.Uuid
  taskId       String?      @map("task_id") @db.Uuid
  clientName   String?      @map("client_name")
  scheduledAt  DateTime?    @map("scheduled_at")
  acknowledged Boolean      @default(false)
  createdAt    DateTime     @default(now()) @map("created_at")

  @@index([toUserId, acknowledged])
  @@index([createdAt])
  @@map("work_reassignments")
}

// ─────────────────────────── Calling ─────────────────────────

/// DB-005 — lead → caller assignment (history-trackable)
model Assignment {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  leadId       String   @map("lead_id") @db.Uuid
  lead         Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  callerId     String   @map("caller_id") @db.Uuid
  caller       User     @relation("AssignmentCaller", fields: [callerId], references: [id])
  assignedById String   @map("assigned_by") @db.Uuid
  assignedBy   User     @relation("AssignmentAssignedBy", fields: [assignedById], references: [id])
  batchName    String?  @map("batch_name")
  isActive     Boolean  @default(true) @map("is_active")
  assignedAt   DateTime @default(now()) @map("assigned_at")

  @@index([leadId])
  @@index([callerId])
  @@map("assignments")
}

/// DB-006 — call records
model Call {
  id           String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  leadId       String       @map("lead_id") @db.Uuid
  lead         Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  callerId     String       @map("caller_id") @db.Uuid
  caller       User         @relation(fields: [callerId], references: [id])
  startTime    DateTime     @map("start_time")
  endTime      DateTime?    @map("end_time")
  durationSecs Int?         @map("duration_secs")
  recordingUrl String?      @map("recording_url")
  // Caller identity used for THIS call (the caller's assigned OpenPhone line at dial
  // time). Stamped on every outbound call so call logs, recordings and activity stay
  // tied to the employee who called, even if their assigned number changes later.
  fromNumber   String?      @map("from_number")
  outcome      String? // Outcome.slug — configurable list (see model Outcome)
  providerSid  String?      @map("provider_sid") // Twilio call SID
  createdAt    DateTime     @default(now()) @map("created_at")

  // ── Quo (OpenPhone) telephony ──
  direction      CommDirection? // inbound / outbound
  status         String? // provider call status (completed, missed, no-answer, …)
  transcript     String? // AI call transcript
  aiSummary      String?        @map("ai_summary") // AI call summary
  quoCallId      String?        @map("quo_call_id") // provider call id
  conversationId String?        @map("conversation_id")

  notes           Note[]
  coachingReport  VoiceCoachingReport?
  recordings      CallRecording[]
  insight         CallInsight?

  @@index([leadId])
  @@index([callerId])
  @@index([startTime])
  @@index([quoCallId])
  @@map("calls")
}

/// AI-generated insight for a recorded call: a structured summary + a
/// speaker-labelled transcript. One row per call (1:1), kept separate from the
/// audio in call_recordings so the original recording is never altered.
/// Generated automatically after a recording syncs from Quo; falls back to a
/// deterministic heuristic when no LLM key is configured (sandbox/dev).
model CallInsight {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  callId         String    @unique @map("call_id") @db.Uuid
  call           Call      @relation(fields: [callId], references: [id], onDelete: Cascade)
  /// pending | processing | ready | failed | unavailable
  status         String    @default("pending")
  /// 9 structured sections: purpose, keyPoints[], customerRequirements[],
  /// questionsAsked[], employeeResponses[], decisions[], followUps[], outcome, nextSteps[]
  summary        Json?
  /// Chronological turns: [{ speaker: 'employee'|'customer', speakerName, text, startSecs, endSecs }]
  transcript     Json?
  /// Flattened text mirrors, so recordings search can match summary/transcript keywords.
  summaryText    String?   @map("summary_text")
  transcriptText String?   @map("transcript_text")
  /// LLM model id used (e.g. claude-opus-4-8), or 'heuristic' for the sandbox fallback.
  model          String?
  /// Where the transcript came from: 'quo' | 'generated' | 'sandbox'.
  source         String?
  error          String?
  generatedAt    DateTime? @map("generated_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@index([status])
  @@map("call_insights")
}

/// Call recording segment synced from Quo (GET /v1/call-recordings/{callId}).
/// A single call can return several segments, so recordings live in their own
/// table; Call.recordingUrl keeps the first segment for existing callers.
model CallRecording {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  callId        String    @map("call_id") @db.Uuid
  call          Call      @relation(fields: [callId], references: [id], onDelete: Cascade)
  /// Quo's recording id — unique so re-syncing a call is idempotent.
  quoRecordingId String?  @unique @map("quo_recording_id")
  url           String
  durationSecs  Int?      @map("duration_secs")
  startTime     DateTime? @map("start_time")
  status        String? // completed, in-progress, failed
  mimeType      String?   @map("mime_type") // e.g. audio/mpeg
  createdAt     DateTime  @default(now()) @map("created_at")

  @@index([callId])
  @@map("call_recordings")
}

enum CommDirection {
  inbound
  outbound
}

/// SMS / message synced from Quo (OpenPhone). Linked to a lead + conversation.
model Message {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  leadId         String?       @map("lead_id") @db.Uuid
  lead           Lead?         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  direction      CommDirection
  body           String
  fromNumber     String        @map("from_number")
  toNumber       String        @map("to_number")
  status         String? // queued, sent, delivered, received, failed
  quoMessageId   String?       @map("quo_message_id")
  conversationId String?       @map("conversation_id")
  createdAt      DateTime      @default(now()) @map("created_at")

  // CRM user who sent this message (outbound sends only). Null for inbound and for
  // provider-synced messages that don't map to a user. `fromNumber` is the line it
  // went out on, so sender + line together flag "sent from the wrong caller ID".
  senderId       String?       @map("sender_id") @db.Uuid
  sender         User?         @relation("MessageSender", fields: [senderId], references: [id])

  @@index([leadId])
  @@index([conversationId])
  @@index([quoMessageId])
  @@index([senderId])
  @@map("messages")
}

/// DB-007 — call notes + follow-up
model Note {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  leadId           String    @map("lead_id") @db.Uuid
  lead             Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  callId           String?   @map("call_id") @db.Uuid
  call             Call?     @relation(fields: [callId], references: [id], onDelete: Cascade)
  noteText         String    @map("note_text")
  nextFollowupDate DateTime? @map("next_followup_date")
  createdById      String    @map("created_by") @db.Uuid
  createdBy        User      @relation(fields: [createdById], references: [id])
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  @@index([leadId])
  @@index([nextFollowupDate])
  @@map("notes")
}

// ──────────────────── Reporting & Notifications ──────────────

/// DB-009 — daily productivity per caller
model ProductivityLog {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  callerId           String   @map("caller_id") @db.Uuid
  caller             User     @relation(fields: [callerId], references: [id])
  date               DateTime @db.Date
  callsMade          Int      @default(0) @map("calls_made")
  connectedCalls     Int      @default(0) @map("connected_calls")
  productiveTimeSecs Int      @default(0) @map("productive_time_secs")
  idleTimeSecs       Int      @default(0) @map("idle_time_secs")
  dealsClosed        Int      @default(0) @map("deals_closed")

  @@unique([callerId, date])
  @@index([date])
  @@map("productivity_logs")
}

/// DB-010 — in-app notifications
model Notification {
  id        String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  user      User             @relation(fields: [userId], references: [id])
  title     String
  body      String
  type      NotificationType
  isRead    Boolean          @default(false) @map("is_read")
  createdAt DateTime         @default(now()) @map("created_at")

  @@index([userId, isRead])
  @@index([createdAt])
  @@map("notifications")
}

/// DB-011 — AI chatbot sessions
model AiTrainingSession {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id])
  question  String
  answer    String
  topic     AiTopic?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("ai_training_sessions")
}

/// Personal task board (Workspace › Tasks)
model Task {
  id        String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title     String
  status    TaskStatus   @default(todo)
  priority  TaskPriority @default(medium)
  dueDate   DateTime?    @map("due_date")
  ownerId   String       @map("owner_id") @db.Uuid
  owner     User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  zoomMeeting ZoomMeeting? @relation("ZoomMeetingTask")

  @@index([ownerId, status])
  @@map("tasks")
}

/// DB-012 — AI voice-coaching analysis per call
model VoiceCoachingReport {
  id                    String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  callId                String        @unique @map("call_id") @db.Uuid
  call                  Call          @relation(fields: [callId], references: [id], onDelete: Cascade)
  callerId              String        @map("caller_id") @db.Uuid
  caller                User          @relation(fields: [callerId], references: [id])
  confidenceScore       Int?          @map("confidence_score") // 1..10
  speakingSpeedRating   SpeakingSpeed? @map("speaking_speed_rating")
  objectionHandlingScore Int?         @map("objection_handling_score") // 1..10
  missedOpportunities   Json?         @map("missed_opportunities")
  createdAt             DateTime      @default(now()) @map("created_at")

  @@index([callerId])
  @@map("voice_coaching_reports")
}
